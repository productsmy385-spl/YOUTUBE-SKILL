# Sir's AI YouTube Agentic Studio - Environment Variables

# Application Runtime
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
NEXT_PUBLIC_APP_URL=https://sir-youtube-studio.up.railway.app
NEXT_PUBLIC_MOCK_MODE=false

# Security & Secrets (Generate strong random keys)
JWT_SECRET=your_jwt_secret_64_characters_hex
TOKEN_ENCRYPTION_KEY=your_aes_256_gcm_32_characters_key

# PostgreSQL Database (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Redis Queue (Railway Redis)
REDIS_URL=redis://default:password@host:6379

# Google Gemini API (Veo Video, Gemini 2.5 Pro & Flash)
GEMINI_API_KEY=your_gemini_api_key

# YouTube Data API v3 (OAuth 2.0)
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=https://sir-youtube-studio.up.railway.app/api/auth/youtube/callback

# Meta Instagram Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://sir-youtube-studio.up.railway.app/api/auth/instagram/callback

# Object Storage (S3 / Cloudflare R2)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=sirs-telugu-studio-assets
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

